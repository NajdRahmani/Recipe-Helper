        "url": "http://host.docker.internal:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"gemma3:4b\",\n  stream: false,\n  messages: [\n    { role: \"system\", content: \"You are a helpful home chef. You receive the user's request, the ingredients the user has (possibly none) and candidate recipes from a database. Choose exactly ONE recipe, the best match for the user's ingredients, and never mention the other candidates. Answer in plain text with no markdown symbols, in this order: 1) Recipe title and time. 2) HAVE: user ingredients that are used in the chosen recipe. 3) MISSING: ingredients of the chosen recipe that the user does not have (maximum 8, skip salt and water). 4) Up to 3 substitutions for missing items. 5) Numbered steps (maximum 8). If the user ingredients are NONE PROVIDED, skip HAVE, MISSING and substitutions, and do not assume the user owns anything. Be concise.\" },\n    { role: \"user\", content: \"User request: \" + $json.query + \"\\nUser ingredients: \" + ($json.user_ingredients.length ? $json.user_ingredients.join(\", \") : \"NONE PROVIDED\") + \"\\n\\nCandidate recipes:\\n\" + $json.context + \"\\n\\nAnswer now. Do not repeat these instructions.\" }\n  ]\n}) }}",
        "options": {
          "timeout": 300000
        }
      },
