    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"qwen2.5:3b\",\n  stream: false,\n  format: \"json\",\n  messages: [\n    { role: \"system\", content: \"You check grounding. Return ONLY JSON: {\\\"grounded\\\": boolean}. grounded is true if the recipe in the answer appears in the provided context, and false if the answer describes a recipe that is not in the context.\" },\n    { role: \"user\", content: \"Context:\\n\" + $('Build context').first().json.context + \"\\n\\nAnswer:\\n\" + $json.message.content }\n  ]\n}) }}",
        "options": {
          "timeout": 300000
        }
      },
