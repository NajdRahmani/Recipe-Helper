    {
      "parameters": {
        "jsCode": "const chef0 = $('Chef').first().json.message.content;\nconst ctx = $('Build context').first().json;\nlet llmGrounded = null;\ntry { llmGrounded = JSON.parse($json.message.content).grounded; } catch (e) {}\nconst norm = s => s.replace(/[’‘´`]/g, \"'\").replace(/[*_#]/g, \"\").toLowerCase();\n\n// 1) drop any echoed instructions\nlet body = chef0.split(/\\n\\s*\\n/)\n  .filter(p => !/you are a helpful home chef|candidate recipes from a database|never mention the other candidates/i.test(p))\n  .join(\"\\n\\n\").trim();\n\n// 2) no user ingredients: remove HAVE / MISSING / SUBSTITUTION lines\nif (!ctx.user_ingredients.length) {\n  body = body.split(\"\\n\")\n    .filter(l => !/^\\s*(HAVE|MISSING|SUBSTITUTION)/i.test(l.replace(/[*_`#]/g, \"\")))\n    .join(\"\\n\").replace(/\\n{3,}/g, \"\\n\\n\");\n}\n\n// 3) rule-based checks\nconst firstLine = body.split(\"\\n\").find(l => l.trim()) || \"\";\nconst title = norm(firstLine).split(/\\s[-–—]\\s/)[0].replace(/^(recipe|title)\\s*:\\s*/i, \"\").trim();\nconst inContext = title.length > 2 && norm(ctx.context).includes(title);\nconst issues = [];\nif ((body.match(/^\\s*\\d+\\./gm) || []).length < 3) issues.push(\"fewer than 3 numbered steps\");\nif (!inContext) issues.push(\"recipe title not found in retrieved recipes\");\nconst note = issues.length ? \"\\n\\nChecks: \" + issues.join(\"; \") : \"\";\n\nlet full = (body + note).replace(/[*_`\\[\\]]/g, \"\");\nif (full.length > 4000) full = full.slice(0, 3990) + \"...\";\nreturn [{ json: { answer: full, llm_grounded: llmGrounded, rule_issues: issues } }];"
      },
