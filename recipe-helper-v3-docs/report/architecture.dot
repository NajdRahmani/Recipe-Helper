digraph G {
  rankdir=LR; fontname="Helvetica"; node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#f4f4f4"]; edge [fontname="Helvetica", fontsize=9];
  tg   [label="Telegram\nmessage", fillcolor="#d6ecff"];
  sw   [label="Input Type\n(photo or text)"];
  tg -> sw;

  subgraph cluster_text { label="text path"; style=dashed;
    ti [label="Text intent\n(qwen2.5:3b)\ningredients / dish / help", fillcolor="#ffe9b3"];
    nt [label="Normalize text"];
    ti -> nt; }
  sw -> ti [label="text"];

  subgraph cluster_img { label="image path"; style=dashed;
    b64 [label="Telegram file\n+ base64"];
    rt  [label="Router (gemma3:4b vision)\n4 classes + visible + confidence", fillcolor="#ffe9b3"];
    sel [label="Route by type"];
    vi  [label="Vision ingredients", fillcolor="#ffe9b3"];
    vd  [label="Vision dish", fillcolor="#ffe9b3"];
    rp  [label="Recipe parser", fillcolor="#ffe9b3"];
    nf  [label="not_food reply", fillcolor="#eeeeee"];
    n1 [label="Normalize 1\nmode=ingredients"]; n2 [label="Normalize 2\nmode=dish"]; n3 [label="Normalize 3\nmode=document"];
    b64 -> rt -> sel; sel -> vi [label="ingredients"]; sel -> vd [label="dish"]; sel -> rp [label="document"]; sel -> nf [label="not_food"];
    vi -> n1; vd -> n2; rp -> n3; }
  sw -> b64 [label="photo"];

  hq [label="Has query?\n(not help, not empty)", shape=diamond, fillcolor="#ffffff"];
  nt -> hq; n1 -> hq; n2 -> hq; n3 -> hq;
  hq -> nomsg [label="no"]; nomsg [label="help / could-not-detect\nmessage", fillcolor="#eeeeee"];

  emb [label="Embed query\n(bge-m3)"]; qd [label="Qdrant search recipes_rich\n40 hits (ingredients) / 10\nfilters: minutes, vegetarian", fillcolor="#e6e0ff"];
  hr [label="Has results?", shape=diamond, fillcolor="#ffffff"];
  rank [label="Rank recipes (code)\ningredients: fewest missing\ndish/text: name match\ndocument: name + ingredient overlap\nbuilds the Chef context", fillcolor="#d9f2d9"];
  hq -> emb [label="yes"]; emb -> qd -> hr; hr -> rank [label="yes (or document)"]; hr -> nores [label="no"]; nores [label="no-match message", fillcolor="#eeeeee"];
  chef [label="Chef (gemma3:4b)\nintro, substitutions, tip", fillcolor="#ffe9b3"];
  pc [label="Parse chef (code)"]; val [label="Validator (qwen2.5:3b)\nsubstitutions, intro, tip", fillcolor="#ffe9b3"];
  fin [label="Final answer (code)\nHAVE/MISSING only for ingredient inputs\nsubstitutions fail closed", fillcolor="#d9f2d9"];
  rank -> chef -> pc -> val -> fin;
  out [label="Telegram reply", fillcolor="#d6ecff"];
  fin -> out; nf -> out; nomsg -> out; nores -> out;
}
